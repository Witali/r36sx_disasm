			dr_mode = "host";
			index_num = <0x1>;
			ctrl_base = <0x18800000>;
			status = "okay";
		};

		persistentmem {
			mtdname = "persistentmem";
			size = <0x8000>;
			status = "okay";
		};

		sfspi {
			pinmux-active = <0x6e 0x1 0x6f 0x1 0x70 0x1 0x71 0x1 0x72 0x1 0x73 0x1>;
			sclk = <0x2faf080>;
			dma-mode = <0x1>;
			status = "okay";

			spi_nor_flash {
				spi-tx-bus-width = <0x1>;
				spi-rx-bus-width = <0x1>;
				reg = <0x0>;
				status = "okay";

				partitions {
					part-num = <0x3>;
					part1-label = "boot";
