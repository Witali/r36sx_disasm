			buffer-header-size = <0x1000>;
			use-static-header;
			status = "okay";
		};

		i2c@0 {
			pinmux-active = <0x11 0x1 0x12 0x1>;
			devpath = "/dev/i2c0";
			baudrate = <0x1c200>;
			mode = "master";
			status = "okay";
		};

		uart@2 {
			devpath = "/dev/uart2";
			status = "disabled";
		};

		uart@3 {
			devpath = "/dev/uart3";
			status = "disabled";
		};

